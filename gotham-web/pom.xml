<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gotham</groupId>
        <artifactId>gotham-news-media-browser</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>gotham-web</artifactId>
    <packaging>jar</packaging>

    <name>gotham-web</name>
    <description>Spring Boot + Thymeleaf app: search UI, /journalist + /article CRUD, global error pages.</description>

    <dependencies>
        <!-- Internal shared module (version comes from the parent dependencyManagement). -->
        <dependency>
            <groupId>com.gotham</groupId>
            <artifactId>gotham-common</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Makes gotham-web the runnable Spring Boot application (repackage into an executable jar). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
