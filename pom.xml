<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Spring Boot BOM parent: it fixes managed dependency versions (Spring, Jackson,
      Elasticsearch client 9.4.5, JUnit, ...) so children declare deps WITHOUT <version>.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.gotham</groupId>
    <artifactId>gotham-news-media-browser</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Gotham News &amp; Media Browser</name>
    <description>Single-brand news &amp; multimedia browser prototype (Elastic Cloud Serverless + public GCS).</description>

    <properties>
        <!-- Build baseline: JDK 25 LTS (matches Spring Boot 4.1.1). Set JAVA_HOME to the Java 25 home. -->
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- GCP client versions come from the Google libraries BOM (imported below). -->
        <google-cloud-libraries-bom.version>26.50.0</google-cloud-libraries-bom.version>
    </properties>

    <!-- P0 modules. gotham-datagen (Java console) is added in P10, not here. -->
    <modules>
        <module>gotham-common</module>
        <module>gotham-web</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Share the internal module version across the reactor so children omit it. -->
            <dependency>
                <groupId>com.gotham</groupId>
                <artifactId>gotham-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!--
              Google Cloud client BOM: fixes google-cloud-storage (and its transitive gax/grpc/
              auth) versions so gotham-common declares the storage client WITHOUT a <version>.
              Kept outside the Spring Boot BOM, which does not manage GCP clients.
            -->
            <dependency>
                <groupId>com.google.cloud</groupId>
                <artifactId>libraries-bom</artifactId>
                <version>${google-cloud-libraries-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                  Failsafe is WIRED here but not bound to any module yet: integration
                  suites (it-es / it-imagebind / it-datagen-helpers) arrive in P9/P10.
                  Surefire (unit tests) is already managed by the Spring Boot parent,
                  so `mvn test` runs unit tests only.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!--
      Integration-test profiles (P9-T03). Failsafe runs the `*IT` classes, split by JUnit tag:
        it-es        → every @Tag("integration") IT EXCEPT the @Tag("imagebind") ones (live ES / GCS)
        it-imagebind → only @Tag("imagebind") ITs (need a running imagebind-service; write path also needs ES)
      Every IT still self-skips via JUnit assumptions when its env vars / deps are absent, so a profile
      run stays green on a box without the dependency. Plain `mvn test` (Surefire) never runs `*IT`.
      Run through the `verify` phase (the reactor must build gotham-common before gotham-web's ITs fork):
        mvn -Pit-es        verify     # env: ES_ENDPOINT, ES_API_KEY (GCS IT also needs GCS_* / skips)
        mvn -Pit-imagebind verify     # env: IMAGEBIND_BASE_URL (+ ES_ENDPOINT/ES_API_KEY for the write path)
      Datagen helpers (it-datagen-helpers) arrive with P10-T06.
    -->
    <profiles>
        <profile>
            <id>it-es</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <groups>integration</groups>
                            <excludedGroups>imagebind</excludedGroups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>it-imagebind</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <groups>imagebind</groups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
