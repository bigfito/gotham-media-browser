# Build output
**/target/

# Secrets — never commit real keys (examples are allowed)
secrets/*.json
!secrets/*.json.example

# Local, untracked config overrides holding REAL values (ES endpoint/api-key, GCS ids).
# application.properties (committed) only carries safe placeholders.
**/application-local.properties

# Docker Compose env override with real values (.env.example is committed).
.env

# IDE
.idea/
*.iml
