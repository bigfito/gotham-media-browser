# Copy to ".env" (gitignored) and fill REAL values for containerized runs.
# Spring relaxed binding maps these to gotham.* properties inside gotham-web.
# NEVER commit the real .env.

GOTHAM_ELASTICSEARCH_ENDPOINT=https://YOUR-ES-ENDPOINT
GOTHAM_ELASTICSEARCH_API_KEY=YOUR_API_KEY

GOTHAM_GCS_PROJECT_ID=YOUR_GCP_PROJECT
GOTHAM_GCS_BUCKET=YOUR_PUBLIC_BUCKET
# Path INSIDE the container (secrets/ is mounted read-only at /app/secrets).
GOTHAM_GCS_CREDENTIALS_FILE=secrets/gcp-sa.json
