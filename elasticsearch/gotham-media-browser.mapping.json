{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "analyzer": {
        "gotham_english": {
          "type": "standard",
          "stopwords": "_english_"
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "_meta": {
      "index": "gotham-media-browser",
      "search_capabilities": {
        "article": [
          "full_text",
          "semantic",
          "hybrid"
        ],
        "journalist": [
          "full_text",
          "semantic",
          "hybrid"
        ],
        "multimedia": [
          "full_text",
          "semantic",
          "hybrid",
          "vector"
        ]
      },
      "embedding": {
        "provider": "meta-imagebind",
        "dims": 1024,
        "fields": {
          "article": "article_embedding",
          "journalist": "journalist_embedding",
          "multimedia": "multimedia.asset_vector"
        },
        "note": "No Elastic managed inference / semantic_text; embeddings supplied by ImageBind helper"
      }
    },
    "properties": {
      "article_id": {
        "type": "long"
      },
      "title": {
        "type": "text",
        "analyzer": "gotham_english",
        "copy_to": [
          "article_search_text"
        ],
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },
      "subtitle": {
        "type": "text",
        "analyzer": "gotham_english",
        "copy_to": [
          "article_search_text"
        ]
      },
      "summary": {
        "type": "text",
        "analyzer": "gotham_english",
        "copy_to": [
          "article_search_text"
        ]
      },
      "body": {
        "type": "text",
        "analyzer": "gotham_english",
        "copy_to": [
          "article_search_text"
        ]
      },
      "slug": {
        "type": "keyword"
      },
      "status": {
        "type": "keyword"
      },
      "language": {
        "type": "keyword"
      },
      "published_at": {
        "type": "date"
      },
      "created_at": {
        "type": "date"
      },
      "updated_at": {
        "type": "date"
      },
      "section": {
        "type": "keyword",
        "fields": {
          "text": {
            "type": "text",
            "analyzer": "gotham_english",
            "copy_to": [
              "article_search_text"
            ]
          }
        }
      },
      "tags": {
        "type": "keyword",
        "fields": {
          "text": {
            "type": "text",
            "analyzer": "gotham_english",
            "copy_to": [
              "article_search_text"
            ]
          }
        }
      },
      "location": {
        "type": "keyword",
        "fields": {
          "text": {
            "type": "text",
            "analyzer": "gotham_english",
            "copy_to": [
              "article_search_text"
            ]
          }
        }
      },
      "source": {
        "type": "keyword",
        "fields": {
          "text": {
            "type": "text",
            "analyzer": "gotham_english"
          }
        }
      },
      "seo_title": {
        "type": "text",
        "analyzer": "gotham_english",
        "copy_to": [
          "article_search_text"
        ]
      },
      "seo_description": {
        "type": "text",
        "analyzer": "gotham_english",
        "copy_to": [
          "article_search_text"
        ]
      },
      "seo_keywords": {
        "type": "text",
        "analyzer": "gotham_english",
        "copy_to": [
          "article_search_text"
        ]
      },
      "canonical_url": {
        "type": "keyword",
        "index": false
      },
      "journalist_names": {
        "type": "text",
        "analyzer": "gotham_english",
        "copy_to": [
          "journalist_search_text"
        ],
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },
      "journalist_bios": {
        "type": "text",
        "analyzer": "gotham_english",
        "copy_to": [
          "journalist_search_text"
        ]
      },
      "multimedia_text": {
        "type": "text",
        "analyzer": "gotham_english",
        "copy_to": [
          "multimedia_search_text"
        ]
      },
      "journalists": {
        "type": "nested",
        "properties": {
          "journalist_id": {
            "type": "long"
          },
          "first_name": {
            "type": "text",
            "analyzer": "gotham_english",
            "fields": {
              "keyword": {
                "type": "keyword",
                "ignore_above": 128
              }
            }
          },
          "last_name": {
            "type": "text",
            "analyzer": "gotham_english",
            "fields": {
              "keyword": {
                "type": "keyword",
                "ignore_above": 128
              }
            }
          },
          "full_name": {
            "type": "text",
            "analyzer": "gotham_english",
            "fields": {
              "keyword": {
                "type": "keyword",
                "ignore_above": 256
              }
            }
          },
          "email": {
            "type": "keyword"
          },
          "bio": {
            "type": "text",
            "analyzer": "gotham_english"
          },
          "byline_order": {
            "type": "integer"
          },
          "contribution_role": {
            "type": "keyword"
          }
        }
      },
      "multimedia": {
        "type": "nested",
        "properties": {
          "multimedia_element_id": {
            "type": "long"
          },
          "media_type": {
            "type": "keyword"
          },
          "storage_uri": {
            "type": "keyword",
            "index": false
          },
          "mime_type": {
            "type": "keyword"
          },
          "position": {
            "type": "integer"
          },
          "caption": {
            "type": "text",
            "analyzer": "gotham_english"
          },
          "credit": {
            "type": "text",
            "analyzer": "gotham_english",
            "fields": {
              "keyword": {
                "type": "keyword",
                "ignore_above": 256
              }
            }
          },
          "title": {
            "type": "text",
            "analyzer": "gotham_english"
          },
          "description": {
            "type": "text",
            "analyzer": "gotham_english"
          },
          "alt_text": {
            "type": "text",
            "analyzer": "gotham_english"
          },
          "original_filename": {
            "type": "keyword",
            "ignore_above": 512
          },
          "file_size_bytes": {
            "type": "long"
          },
          "checksum": {
            "type": "keyword",
            "index": false
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "duration_ms": {
            "type": "long"
          },
          "codec": {
            "type": "keyword"
          },
          "bitrate_kbps": {
            "type": "integer"
          },
          "frame_rate": {
            "type": "float"
          },
          "sample_rate_hz": {
            "type": "integer"
          },
          "channels": {
            "type": "integer"
          },
          "asset_vector": {
            "type": "dense_vector",
            "dims": 1024,
            "index": true,
            "similarity": "cosine",
            "index_options": {
              "type": "int8_hnsw",
              "m": 16,
              "ef_construction": 100
            }
          }
        }
      },
      "article_search_text": {
        "type": "text",
        "analyzer": "gotham_english"
      },
      "journalist_search_text": {
        "type": "text",
        "analyzer": "gotham_english"
      },
      "multimedia_search_text": {
        "type": "text",
        "analyzer": "gotham_english"
      },
      "article_embedding": {
        "type": "dense_vector",
        "dims": 1024,
        "index": true,
        "similarity": "cosine",
        "index_options": {
          "type": "int8_hnsw",
          "m": 16,
          "ef_construction": 100
        }
      },
      "journalist_embedding": {
        "type": "dense_vector",
        "dims": 1024,
        "index": true,
        "similarity": "cosine",
        "index_options": {
          "type": "int8_hnsw",
          "m": 16,
          "ef_construction": 100
        }
      }
    }
  }
}
