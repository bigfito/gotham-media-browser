<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gotham</groupId>
        <artifactId>gotham-news-media-browser</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>gotham-common</artifactId>
    <packaging>jar</packaging>

    <name>gotham-common</name>
    <description>Shared domain, config properties, and ES/GCS/ImageBind clients (populated from P1 onward).</description>

    <dependencies>
        <!-- Core Spring (no web): supports @ConfigurationProperties / @Component beans added later. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Elasticsearch Java API Client (version pinned by the Spring Boot BOM: 9.4.5). -->
        <dependency>
            <groupId>co.elastic.clients</groupId>
            <artifactId>elasticsearch-java</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!--
                Default module resources. Re-declared explicitly because adding a second <resource>
                below replaces Maven's implicit default; without this line src/main/resources would
                stop being packaged.
            -->
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
            </resource>
            <!--
                Ship the approved index mappings onto the classpath as elasticsearch/*.mapping.json,
                reusing the SINGLE source of truth at the repository root (../elasticsearch) so the
                JSON is never duplicated and cannot drift from the design docs that link to it.
                P2-T02's idempotent bootstrap loads these from the classpath.
            -->
            <resource>
                <directory>${project.basedir}/../elasticsearch</directory>
                <targetPath>elasticsearch</targetPath>
                <includes>
                    <include>*.mapping.json</include>
                </includes>
            </resource>
        </resources>
    </build>
</project>
